{
  "name": "@ladder/rung-7-shipped",
  "version": "1.0.0",
  "description": "Tutors ladder, rung 7 (Shipped): the rung 3 workspace with a versioned, gated, containerised release and checked claims",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "start": "node apps/cli/src/main.ts",
    "typecheck": "tsc -p packages/model && tsc -p packages/gen && tsc -p packages/lite && tsc -p apps/cli && tsc -p .",
    "test": "pnpm typecheck && node --test \"packages/*/tests/*.test.ts\" \"apps/*/tests/*.test.ts\" \"scripts/tests/*.test.ts\" \"tests/**/*.test.ts\"",
    "release:version": "node scripts/release-version.ts",
    "release:claims": "node scripts/check-release-claims.ts",
    "release:slo": "node scripts/check-slo.ts",
    "release:readiness": "node scripts/release-readiness.ts",
    "container:smoke": "node scripts/container-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "typescript": "^6.0.3",
    "yaml": "2.9.1"
  }
}
