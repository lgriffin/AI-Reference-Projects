{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.mutation.ts"
  },
  "mutate": [
    "packages/gen/src/course-builder.ts",
    "packages/gen/src/lo-kinds.ts",
    "packages/gen/src/memory-file-system.ts",
    "packages/lite/src/html.ts",
    "packages/lite/src/markdown.ts",
    "packages/lite/src/site-builder.ts"
  ],
  "reporters": [
    "html",
    "clear-text",
    "progress",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 90
  },
  "concurrency": 4,
  "timeoutMS": 30000,
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ObjectLiteral"
    ]
  },
  "ignorePatterns": [
    "node_modules",
    "reports",
    ".stryker-tmp*",
    "out"
  ],
  "disableTypeChecks": "{packages/**/*.ts,tests/**/*.ts}"
}
