+
+
+def test_a_task_can_be_deleted(
+    client: TestClient, caplog: pytest.LogCaptureFixture
+) -> None:
+    caplog.set_level("INFO")
+    task_id = create(client, "Delete me")
+
+    response = delete(client, task_id)
+    assert response.status_code == 204
+    assert response.content == b""
+
+    # Task should no longer exist
+    assert client.get(f"/tasks/{task_id}").status_code == 404
+    assert client.get("/tasks").json() == []
+    assert "Task deleted: Delete me" in caplog.text
+
+
+def test_a_task_in_progress_cannot_be_deleted(client: TestClient) -> None:
+    task_id = create(client, "In progress task")
+    move(client, task_id, "in_progress")
+
+    response = delete(client, task_id)
+    assert response.status_code == 409
+    assert response.json()["code"] == "task_in_progress"
+
+    # Task should still exist
+    assert client.get(f"/tasks/{task_id}").status_code == 200
+
+
+def test_a_done_task_can_be_deleted(client: TestClient) -> None:
+    task_id = create(client, "Done task")
+    move(client, task_id, "in_progress")
+    move(client, task_id, "done")
+
+    response = delete(client, task_id)
+    assert response.status_code == 204
+
+    # Task should no longer exist
+    assert client.get(f"/tasks/{task_id}").status_code == 404
+
+
+def test_unknown_task_deletion_returns_404(client: TestClient) -> None:
+    response = delete(client, "unknown-id")
+    assert response.status_code == 404
+    assert response.json()["code"] == "task_not_found"
