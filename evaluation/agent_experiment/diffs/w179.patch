index 0000000..590e507
--- /dev/null
+++ b/src/main/java/com/example/taskboard/events/DeletionAnnouncer.java
@@ -0,0 +1,20 @@
+package com.example.taskboard.events;
+
+import com.example.taskboard.domain.TaskDeleted;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.stereotype.Component;
+import org.springframework.transaction.event.TransactionalEventListener;
+
+/** Events: side effects live here, one small method per reaction. */
+@Component
+class DeletionAnnouncer {
+
+    private static final Logger log = LoggerFactory.getLogger(DeletionAnnouncer.class);
+
+    /** Stands in for a notification to the team. Runs only after the change has committed. */
+    @TransactionalEventListener
+    void announce(TaskDeleted event) {
+        log.info("Task deleted: {} ({})", event.title(), event.taskId());
+    }
+}
