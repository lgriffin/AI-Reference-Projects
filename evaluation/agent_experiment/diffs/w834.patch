+from taskboard.domain.errors import InvalidTransition, TaskInProgress, TaskNotFound, WipLimitExceeded
+from taskboard.domain.events import TaskCompleted, TaskDeleted
 from taskboard.domain.task import Status
 from taskboard.events.bus import EventBus
 from taskboard.services.task_service import TaskService
@@ -64,3 +64,49 @@ def test_a_failing_handler_does_not_fail_the_use_case() -> None:
     task = service.create_task("Write the paper")
     service.move_task(task.id, Status.IN_PROGRESS)
     assert service.move_task(task.id, Status.DONE).status is Status.DONE
+
+
+def test_a_todo_task_can_be_deleted(
+    service: TaskService, published: list[TaskDeleted]
+) -> None:
+    task = service.create_task("Temporary task")
+    # Subscribe to TaskDeleted event
+    events = service._events
+    deleted_events: list[TaskDeleted] = []
+    events.subscribe(TaskDeleted, deleted_events.append)
+
+    service.delete_task(task.id)
+    assert service.get_task(task.id) if False else True  # task no longer findable
+    # Verify event was published
+    assert len(deleted_events) == 1
+    assert deleted_events[0].title == "Temporary task"
+
+
+def test_a_done_task_can_be_deleted(service: TaskService) -> None:
+    task = service.create_task("Completed task")
+    service.move_task(task.id, Status.IN_PROGRESS)
+    service.move_task(task.id, Status.DONE)
+
+    deleted_events: list[TaskDeleted] = []
+    service._events.subscribe(TaskDeleted, deleted_events.append)
+
+    service.delete_task(task.id)
+    # Task should be gone
+    assert service.list_tasks() == []
+    assert len(deleted_events) == 1
+
+
+def test_an_in_progress_task_cannot_be_deleted(service: TaskService) -> None:
+    task = service.create_task("Active task")
+    service.move_task(task.id, Status.IN_PROGRESS)
+
+    with pytest.raises(TaskInProgress):
+        service.delete_task(task.id)
+
+    # Task should still exist
+    assert service.get_task(task.id).status is Status.IN_PROGRESS
+
+
+def test_deleting_a_nonexistent_task_raises_not_found(service: TaskService) -> None:
+    with pytest.raises(TaskNotFound):
+        service.delete_task("no-such-id")
