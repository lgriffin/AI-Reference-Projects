diff --git a/tests/api/test_task_api.py b/tests/api/test_task_api.py
index e658677..81173d2 100644
--- a/tests/api/test_task_api.py
+++ b/tests/api/test_task_api.py
@@ -55,3 +55,48 @@ def test_every_failure_is_a_problem_document(client: TestClient) -> None:
         assert response.status_code == status
         assert response.headers["content-type"] == "application/problem+json"
         assert response.json()["code"] == code
+
+
+def test_a_todo_task_can_be_deleted(client: TestClient) -> None:
+    task_id = create(client, "Remove this")
+    response = client.delete(f"/tasks/{task_id}")
+    assert response.status_code == 204
+    assert response.content == b""
+
+    # Verify task is gone
+    assert client.get(f"/tasks/{task_id}").status_code == 404
+
+
+def test_a_done_task_can_be_deleted(client: TestClient) -> None:
+    task_id = create(client, "Finished work")
+    move(client, task_id, "in_progress")
+    move(client, task_id, "done")
+
+    response = client.delete(f"/tasks/{task_id}")
+    assert response.status_code == 204
+
+
+def test_an_in_progress_task_cannot_be_deleted(client: TestClient) -> None:
+    task_id = create(client, "Active work")
+    move(client, task_id, "in_progress")
+
+    response = client.delete(f"/tasks/{task_id}")
+    assert response.status_code == 409
+    assert response.json()["code"] == "task_in_progress"
+
+    # Task should still exist
+    assert client.get(f"/tasks/{task_id}").status_code == 200
+
+
+def test_deleting_a_nonexistent_task_returns_not_found(client: TestClient) -> None:
+    response = client.delete("/tasks/no-such-id")
+    assert response.status_code == 404
+    assert response.json()["code"] == "task_not_found"
+
+
+def test_deletion_publishes_an_event(client: TestClient, caplog: pytest.LogCaptureFixture) -> None:
+    caplog.set_level("INFO")
+    task_id = create(client, "Log this deletion")
+    client.delete(f"/tasks/{task_id}")
+
+    assert "Task deleted: Log this deletion" in caplog.text
