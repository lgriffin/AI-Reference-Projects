% jotlocal.sty -- a stand-in for the Journal of Object Technology class.
%
% The official JOT LaTeX template could not be downloaded when this draft was started (the
% build environment's network policy blocks www.jot.fm). This package gives the draft a
% JOT-like single-column A4 layout so the text, figures and references can be written now.
% To move to the official class: replace \documentclass and \usepackage{jotlocal} in main.tex
% with the lines from JOT's template, and map \jottitle, \jotauthors and \jotabstract onto its
% front-matter commands. Nothing in sections/ depends on this file.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{jotlocal}[2026/09/29 Stand-in layout for a JOT draft]

\RequirePackage[a4paper,margin=2.5cm]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{lmodern}
\RequirePackage{microtype}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{multirow}
\RequirePackage{enumitem}
\RequirePackage{listings}
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\RequirePackage{caption}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage[hidelinks]{hyperref}

\pgfplotsset{compat=1.18}
\usetikzlibrary{arrows.meta,positioning,shapes.geometric,calc,fit,backgrounds,decorations.pathreplacing}

% Palette: one colour per kind of intent, used consistently in every figure.
\definecolor{jotblue}{HTML}{1F3B5A}
\definecolor{structure}{HTML}{0E6A5B}
\definecolor{behaviour}{HTML}{3B4DAE}
\definecolor{requirement}{HTML}{9A5A08}
\definecolor{muted}{HTML}{5B6661}
\definecolor{wash}{HTML}{EEF2F0}
\definecolor{caught}{HTML}{1E7A45}
\definecolor{compiler}{HTML}{335E9C}
\definecolor{behav}{HTML}{B08A1E}
\definecolor{reqc}{HTML}{7A4FB0}
\definecolor{missed}{HTML}{B0322B}

\titleformat{\section}{\large\bfseries\color{jotblue}}{\thesection}{0.8em}{}
\titleformat{\subsection}{\normalsize\bfseries\color{jotblue}}{\thesubsection}{0.8em}{}
\titleformat{\paragraph}[runin]{\normalsize\bfseries}{}{}{}[.]
\captionsetup{font=small,labelfont={bf,color=jotblue}}
\setlist{itemsep=2pt,topsep=4pt}

\lstset{
  basicstyle=\ttfamily\footnotesize,
  columns=fullflexible,
  keepspaces=true,
  frame=lines,
  framerule=0.4pt,
  rulecolor=\color{muted},
  xleftmargin=1em,
  xrightmargin=1em,
  numbers=none,
  showstringspaces=false,
  commentstyle=\color{muted}\itshape,
  keywordstyle=\color{jotblue}\bfseries,
  stringstyle=\color{requirement},
  captionpos=b,
}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\fancyhead[L]{\small\color{muted}Journal of Object Technology (draft)}
\fancyhead[R]{\small\color{muted}The Assertion Ladder}
\fancyfoot[C]{\small\thepage}

% Front matter.
\newcommand{\jottitle}[1]{\def\@jottitle{#1}}
\newcommand{\jotauthors}[1]{\def\@jotauthors{#1}}
\newcommand{\jotabstract}[1]{\def\@jotabstract{#1}}
\newcommand{\jotkeywords}[1]{\def\@jotkeywords{#1}}
\newcommand{\jotmaketitle}{%
  \thispagestyle{plain}%
  \begin{center}
    {\color{jotblue}\rule{\linewidth}{1.2pt}}\\[0.8em]
    {\LARGE\bfseries\color{jotblue}\@jottitle\par}\vspace{1em}
    {\normalsize\def\and{\unskip,\ }\@jotauthors\par}\vspace{0.6em}
    {\color{jotblue}\rule{\linewidth}{0.4pt}}
  \end{center}
  \begin{quote}\small
    \textbf{Abstract}\quad\@jotabstract\par\vspace{0.6em}
    \textbf{Keywords}\quad\@jotkeywords
  \end{quote}
  \vspace{1em}}

% Writing aids: a visible marker for text the authors still owe.
\newcommand{\todo}[1]{{\color{missed}\textbf{[TODO:} #1\textbf{]}}}
\newcommand{\rung}[1]{\textsf{\textbf{#1}}}
\newcommand{\pattern}[1]{\textsc{#1}}
\newcommand{\repo}[1]{\texttt{#1}}
